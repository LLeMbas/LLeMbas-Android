<?xml version="1.0" encoding="utf-8"?>
<!-- A self-hosted instance often sits behind its owner's own certificate authority. Trusting
     the CAs the person installed on this phone (Settings › Security › Install a certificate)
     is what lets the app reach it -- the same step the browser needs. No plain HTTP: a token
     goes with every request. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
